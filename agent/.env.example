# Copy these values to agent/.env for local S3-compatible development storage.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tyox-projects
S3_PREFIX=tyox/projects
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tyox-local
AWS_SECRET_ACCESS_KEY=tyox-local-secret
RUSTFS_ACCESS_KEY=tyox-local
RUSTFS_SECRET_KEY=tyox-local-secret
