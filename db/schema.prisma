// use prisma-8
// Prisma ORM 8 data contract for tyox.

model User {
  id        String    @id @default(uuid())
  username  String    @unique
  password  String
  createdAt TimestamptzString @default(now())
  projects  Project[]
}

model Project {
  id                   String               @id @default(uuid())
  userid               String
  owner                User                 @relation(fields: [userid], references: [id])
  title                String
  initialPrompt        String
  createdAt            TimestamptzString    @default(now())
  updatedAt            TimestamptzString    @default(now())
  conversation_history ConversationHistory[]
  agentRuns            AgentRun[]
  todos                Todo[]

  @@index([userid])
}

model ConversationHistory {
  id        String         @id @default(uuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id])
  convos    Conversation[]
  agentRuns AgentRun[]
  agentState String?
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  @@index([projectId])
}

model AgentRun {
  id             String              @id @default(uuid())
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id])
  conversationId String
  conversation   ConversationHistory @relation(fields: [conversationId], references: [id])
  prompt         String
  status         AgentRunStatus      @default(QUEUED)
  attempts       Int                 @default(0)
  error          String?
  createdAt      TimestamptzString   @default(now())
  updatedAt      TimestamptzString   @default(now())
  startedAt      TimestamptzString?
  finishedAt     TimestamptzString?

  @@index([projectId, status])
  @@index([conversationId])
}

model Conversation {
  id              String             @id @default(uuid())
  conversation_id String
  conversation_history ConversationHistory @relation(fields: [conversation_id], references: [id])
  From            MessageFrom
  Content         String
  ConversationType ConversationType
  toolcall        Toolcall?
  createdAt       TimestamptzString  @default(now())

  @@index([conversation_id])
}

model Todo {
  id          String          @id @default(uuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id])
  title       String
  description String?
  completed   Boolean         @default(false)
  position    Int             @default(0)
  createdAt   TimestamptzString @default(now())

  @@index([projectId])
}

enum MessageFrom {
  USER
  ASSISTANT
}

enum Toolcall {
  READ_FILE
  WRITE_FILE
  DELETE_FILE
  UPDATE_FILE
  QNA
  CREATE_TODOS
}

enum ConversationType {
  TOOL_CALL
  TEXT_MESSAGE
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING
  COMPLETED
  FAILED
}
